<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DigitalWalletApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidDigitalWallet"
        tools:targetApi="31">
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
          MainActivity is the single entry point for UI, launcher, and deep links.
          - launchMode="singleTop" ensures warm-start deep links route to onNewIntent
            without creating duplicate Activity or Navigator instances.
          - Security posture:
            * android:exported="true" is required for LAUNCHER and VIEW intent filters.
            * All query and path parameters are untrusted input; resolvers validate them.
            * Sensitive destinations should use verified App Links (https) to prevent
              custom scheme hijacking on Android < 12.
            * Custom scheme and App Links filters are kept separate to avoid combinatorial
              matching of schemes and hosts.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AndroidDigitalWallet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom scheme deep link entry point (${deepLinkScheme}://...) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="${deepLinkScheme}" />
            </intent-filter>

            <!-- Verified App Links entry point (https://${appLinkHost}/...) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="${appLinkHost}" />
            </intent-filter>
        </activity>
    </application>

</manifest>
